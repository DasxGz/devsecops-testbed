{
  "openapi": "3.0.0",
  "info": {
    "title": "Banco de pruebas DevSecOps - API Gateway",
    "version": "1.0.0",
    "description": "Rutas del gateway y de los servicios de usuarios y productos. Vulnerable a propósito."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Verificación de salud",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/debug": {
      "get": {
        "summary": "Depuración",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/registro": {
      "post": {
        "summary": "Registro de usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Prueba ZAP"
                  },
                  "email": {
                    "type": "string",
                    "example": "zap@testbed.local"
                  },
                  "password": {
                    "type": "string",
                    "example": "Zap123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado"
          }
        }
      }
    },
    "/api/usuarios/login": {
      "post": {
        "summary": "Inicio de sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "ana@testbed.local"
                  },
                  "password": {
                    "type": "string",
                    "example": "Ana2026"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/perfil/{id}": {
      "get": {
        "summary": "Perfil de usuario",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "000000000000000000000000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/productos/": {
      "get": {
        "summary": "Catálogo",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/productos/buscar": {
      "get": {
        "summary": "Búsqueda",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "laptop"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/productos/exportar": {
      "get": {
        "summary": "Exportación",
        "parameters": [
          {
            "name": "formato",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "csv"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/productos/{id}": {
      "get": {
        "summary": "Detalle de producto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "000000000000000000000000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}